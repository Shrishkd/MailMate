# Copy to .env (git-ignored) and fill in. Never commit .env.

# Your n8n workspace, no trailing slash. After the Docker move: http://localhost:5678
N8N_BASE_URL=https://<name>.app.n8n.cloud

# Sent as the X-MailMate-Token header on every webhook call (README: Setup, step 2.3).
N8N_WEBHOOK_TOKEN=

# Rule 2: your own secondary inbox. Test emails go only here (W2 checks it too).
MAILMATE_TEST_ADDRESS=
